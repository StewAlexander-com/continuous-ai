# --- Continuous-AI: runtime-generated state (never commit) ---
.seedling_db/
logs/
snapshots/
training_data/
adapters/
models/

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Secrets ---
.env
*.key

# Deliberation lineage ledger (runtime state)
deliberation_ledger/

# Collaborative-wall event ledger (runtime state, parallel to the above)
collaborate_ledger/

# --- Local one-off maintenance scripts & their backups (not part of the runtime) ---
# e.g. quarantine_delta.py: a hand-run tool to quarantine a confabulated belief
# (archive-not-delete) and the timestamped state backups it writes.
quarantine_delta.py
state_backup_*.json

# --- L3 A/B eval outputs (throwaway, derived from real deltas) ---
l3_eval_out/

# --- Local neural voice model (Kokoro), ~330 MB, exceeds GitHub's 100 MB limit ---
# Provisioned on demand by `bash setup_voice.sh`; Aida falls back to macOS `say`
# until present. Declared as hers via tts_voice: "af_kore" in config.yaml.
kokoro-v1.0.onnx
voices-v1.0.bin

# --- Personal settings ---
# config.yaml is the shipped default and stays tracked (Aida needs it).
# Your machine-specific deltas live here and are never committed;
# :enable / :disable / :allow write to this file, not to config.yaml.
config.local.yaml
